# Copy this file to .env in the studio directory.
# Never commit real API keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional model defaults
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-5

# Local-only by default. Do not expose this server publicly without authentication.
HOST=127.0.0.1
PORT=4177
